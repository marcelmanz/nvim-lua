{
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "lua/?.lua",
      "lua/?/init.lua",
      "?/lua/?.lua",
      "?/lua/?/init.lua"
    ]
  },
  "diagnostics": {
    "globals": ["vim", "MiniNotify", "MiniPick", "MiniSnippets"],
    "disable": ["missing-fields", "preferred-local-alias"]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "$VIMRUNTIME",
      "$LLS_Addons/luvit",
      "$HOME/.local/share/nvim/lazy",
      "$HOME/clones/own/highlighter.nvim"
    ],
    "ignoreGlobs": [
      "**/*_spec.lua"
    ]
  }
}
